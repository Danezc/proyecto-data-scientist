# ====================================================
# Configuración Central del Proyecto TUMIPAY
# NOTA: Duplicar este archivo como '.env'
# ====================================================

# Backend & FastAPI
PORT=8000
ENVIRONMENT=dev # Valores permitidos: dev, staging, prod

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=sb_publishable_replace-with-your-anon-key

# Configuración RAG y Base de Datos (Supabase / PGVector)
# IMPORTANTE: Utilizar la conexión de tipo Pooler (puerto 6543) para evitar problemas de IPv6
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Inteligencia Artificial & RAG
NVIDIA_API_KEY=replace-with-your-nvidia-api-key

# LangSmith (Telemetría y Observabilidad de Tokens) - OPCIONAL
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=replace-with-your-langsmith-api-key
LANGCHAIN_PROJECT=TumiPay_RAG

# Configuración de Archivos Core
DATA_BASE_PATH=./data
CUTOFF_DATE=2026-04-30