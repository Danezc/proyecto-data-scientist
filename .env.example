# ====================================================
# Configuración Central del Proyecto TUMIPAY
# NOTA: Duplicar este archivo como '.env'
# ====================================================

# Backend & FastAPI
PORT=8000
ENVIRONMENT=dev # Valores permitidos: dev, staging, prod

# Configuración RAG y Base de Datos (PGVector)
DATABASE_URL=postgresql://root:root@localhost:5432/tumipay_db

# Inteligencia Artificial & RAG
NVIDIA_API_KEY=replace-with-your-nvidia-api-key

# LangSmith (Telemetría y Observabilidad de Tokens) - OPCIONAL
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=replace-with-your-langsmith-api-key
LANGCHAIN_PROJECT=TumiPay_RAG

# Configuración de Archivos Core
DATA_BASE_PATH=./data
CUTOFF_DATE=2026-04-30