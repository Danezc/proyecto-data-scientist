# ── Entornos virtuales ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Python compilado y caché ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
dist/
build/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Secretos y configuración local
.env
.env.*
# La plantilla sí se versiona (no contiene claves reales)
!.env.example

# ── Datos (no subir CSVs ni parquets) ────────────────────────────────────────
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
!/data/processed/README.md
!/data/processed/powerbi/
!/data/processed/powerbi/*.parquet
!/data/processed/powerbi/manifest.json

# ── Modelos entrenados (binarios grandes) ────────────────────────────────────
/models/*
!/models/.gitkeep

# ── Power BI (binarios no versionables, pueden contener datos cacheados) ─────
*.pbix
!/dashboard/**/*.pbix
# ✅ Los archivos .pbit (plantilla sin datos) sí se pueden versionar

# ── Sistema operativo ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log

# ── IDEs ──────────────────────────────────────────────────────────────────────
.idea/
*.swp
*.swo
